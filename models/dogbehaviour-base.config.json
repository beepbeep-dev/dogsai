{
  "task": "multilabel",
  "behaviours": [
    "barking",
    "chewing",
    "eating_drinking",
    "eliminating",
    "playing",
    "yawning"
  ],
  "data": {
    "root": "/root/data/prepared/enriched",
    "train_split": "train",
    "val_split": "val",
    "clip_frames": 24,
    "frame_stride": 2,
    "image_size": 192,
    "train_scale": [
      0.65,
      1.0
    ],
    "sampling": "tsn",
    "hflip": 0.5,
    "colour_jitter": 0.25,
    "grey": 0.05,
    "erase": 0.15,
    "temporal_reverse": 0.0,
    "num_workers": 8,
    "prefetch_factor": 2,
    "pin_memory": true,
    "cache_index": true
  },
  "model": {
    "preset": "base",
    "width": 1.0,
    "depth": 1.25,
    "dropout": 0.2,
    "drop_path": 0.05,
    "head_dim": 768,
    "motion_stem": true,
    "temporal_pool": "attention",
    "attn_heads": 4,
    "se_ratio": 0.25
  },
  "train": {
    "epochs": 100,
    "batch_size": 12,
    "accum_steps": 2,
    "lr": 0.0003,
    "min_lr": 1e-06,
    "weight_decay": 0.05,
    "warmup_epochs": 2.0,
    "grad_clip": 1.0,
    "label_smoothing": 0.1,
    "mixup": 0.2,
    "focal_gamma": 1.5,
    "class_balanced": true,
    "ema_decay": 0.999,
    "amp": true,
    "channels_last": true,
    "early_stop_patience": 20,
    "seed": 1337,
    "out_dir": "/root/runs/dognet",
    "log_every": 10,
    "compile": false
  },
  "infer": {
    "window_stride": 0.5,
    "batch_size": 8,
    "smooth": 3,
    "threshold": 0.5,
    "min_duration": 0.35,
    "merge_gap": 0.25,
    "tta_hflip": false
  }
}
